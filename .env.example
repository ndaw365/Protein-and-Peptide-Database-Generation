# Copy to .env (git-ignored, loaded automatically). Edit lines; don't append duplicates:
# the first line for a setting wins, and shell variables override this file.
# OpenAI is tried first; Gemini is used when there is no OpenAI key or OpenAI fails.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional. If a provider retires or overloads a model, set another one here.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash   # comma-separated, tried in order if busy
# OPENAI_FALLBACK_MODELS=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM_TIMEOUT=180      # seconds per request
# RAG_DATA_DIR=data    # where the index and ClinVar download are stored
