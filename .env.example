# Copy to .env (git-ignored) or export these in your shell.
# OpenAI is used first; Gemini is the fallback when OpenAI is missing or fails.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# RAG_DATA_DIR=data
