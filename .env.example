# Copy to .env (git-ignored; loaded automatically) or export these in your shell.
# Shell variables take priority over this file.
# OpenAI is used first; Gemini is the fallback when OpenAI is missing or fails.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides. Providers retire models: if you get a "model not found" or
# "no longer available" error, set the model name the error suggests here.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# RAG_DATA_DIR=data
